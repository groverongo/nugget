{
	"name": "nugget-bot",
	"scripts": {
		"dev": "nodemon src/app.ts | pino-pretty",
		"prepare": "husky",
		"clean": "rimraf dist",
		"build": "pnpm clean && tsc -p .",
		"start": "node dist/app.js",
		"lint": "biome check .",
		"lint:fix": "biome check . --write",
		"migrate:up": "ts-node ./cmd/migration/migration.ts up | pino-pretty",
		"migrate:down": "ts-node ./cmd/migration/migration.ts down | pino-pretty",
		"migrate:status": "ts-node ./cmd/migration/migration.ts status | pino-pretty",
		"migrate:create": "f() { ts-node ./cmd/migration/migration.ts create \"$@\" | pino-pretty; }; f"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.15",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^25.9.1",
		"@types/pg": "^8.20.0",
		"husky": "^9.1.7",
		"nodemon": "^3.1.14",
		"rimraf": "^6.1.3",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^6.0.3"
	},
	"dependencies": {
		"discord": "^0.8.2",
		"dotenv": "^17.4.2",
		"js-yaml": "^4.1.1",
		"pg": "^8.21.0",
		"pino": "^10.3.1",
		"pino-pretty": "^13.1.3",
		"zod": "^4.4.3"
	},
	"packageManager": "pnpm@10.30.1"
}
