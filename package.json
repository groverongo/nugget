{
	"name": "nugget-bot",
	"scripts": {
		"dev": "nodemon src/app.ts",
		"clean": "rimraf dist",
		"build": "pnpm clean && tsc -p .",
		"start": "node dist/app.js",
		"lint": "biome check .",
		"lint:fix": "biome check . --write",
		"migrate:up": "ts-node ./cmd/migration/migration.ts up",
		"migrate:down": "ts-node ./cmd/migration/migration.ts down",
		"migrate:status": "ts-node ./cmd/migration/migration.ts status",
		"migrate:create": "ts-node ./cmd/migration/migration.ts create"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.15",
		"@types/node": "^25.9.1",
		"@types/pg": "^8.20.0",
		"nodemon": "^3.1.14",
		"rimraf": "^6.1.3",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^6.0.3"
	},
	"dependencies": {
		"pg": "^8.21.0"
	},
	"packageManager": "pnpm@10.30.1"
}
