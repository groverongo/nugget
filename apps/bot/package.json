{
	"name": "nugget-bot",
	"scripts": {
		"dev": "nodemon --exec \"ts-node -r tsconfig-paths/register\" src/app.ts | pino-pretty",
		"prepare": "lefthook install",
		"install:images": "docker pull sqlc/sqlc:latest",
		"clean": "rimraf dist",
		"build": "pnpm clean && tsc && tsc-alias",
		"start": "node dist/src/app.js",
		"test": "jest --runInBand --coverage",
		"lint": "biome check .",
		"lint:fix": "biome check . --write",
		"migrate:up": "ts-node -r tsconfig-paths/register ./cmd/migration.ts up | pino-pretty",
		"migrate:down": "ts-node -r tsconfig-paths/register ./cmd/migration.ts down | pino-pretty",
		"migrate:status": "ts-node -r tsconfig-paths/register ./cmd/migration.ts status | pino-pretty",
		"migrate:create": "f() { ts-node -r tsconfig-paths/register ./cmd/migration.ts create \"$@\" | pino-pretty; }; f",
		"seed": "ts-node -r tsconfig-paths/register ./cmd/seeding.ts | pino-pretty",
		"generate:db": "cd db && docker run --rm -u \"$(id -u):$(id -g)\" -e HOME=/src -v \"$(pwd):/src\" -w /src sqlc/sqlc generate",
		"generate": "pnpm run generate:db"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.15",
		"@types/jest": "^30.0.0",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^25.9.1",
		"@types/pg": "^8.20.0",
		"jest": "^30.2.0",
		"lefthook": "^2.1.8",
		"nodemon": "^3.1.14",
		"rimraf": "^6.1.3",
		"ts-jest": "^29.4.5",
		"ts-node": "^10.9.2",
		"tsc-alias": "^1.8.17",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^6.0.3"
	},
	"dependencies": {
		"discord.js": "^14.26.4",
		"dotenv": "^17.4.2",
		"js-yaml": "^4.1.1",
		"pg": "^8.21.0",
		"pino": "^10.3.1",
		"pino-pretty": "^13.1.3",
		"zod": "^4.4.3"
	},
	"packageManager": "pnpm@10.30.1"
}
